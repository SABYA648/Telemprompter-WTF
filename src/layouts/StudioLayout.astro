---
import UmamiScript from '../components/UmamiScript.astro';
import '../styles/studio.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090a09" />
    <meta name="robots" content="noindex,follow" />
    <title>Studio | teleprompter.wtf</title>
    <meta
      name="description"
      content="Write and organize video scripts locally with teleprompter.wtf Studio."
    />
    <link rel="canonical" href="https://www.teleprompter.wtf/studio" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <UmamiScript />
  </head>
  <body class="studio-body"><main id="studio-main"><slot /></main></body>
</html>
