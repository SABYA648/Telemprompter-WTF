---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  rss?: string;
}

const {
  title,
  description,
  image = '/og.png',
  ogType = 'website',
  schema,
  noindex = false,
  rss,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.teleprompter.wtf');
const socialImage = new URL(image, Astro.site ?? 'https://www.teleprompter.wtf');
const socialImageType = image.endsWith('.webp') ? 'image/webp' : 'image/png';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://sabya.pm/#person',
  name: 'Sabyasachi Mishra',
  url: 'https://sabya.pm',
  image: 'https://sabya.pm/embed/author-card/avatar-192.webp',
  jobTitle: 'AI Product Manager',
  description:
    'AI product manager who builds production AI systems and independently operates Shiproom, teleprompter.wtf, and compressimage.fun.',
  knowsAbout: ['AI product management', 'AI systems', 'autonomous agents', 'product strategy'],
  sameAs: [
    'https://x.com/SabyaShips',
    'https://www.linkedin.com/in/sabya007/',
    'https://github.com/SABYA648',
    'https://medium.com/@sabyasachimishra648',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4efe5" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" title="LLM-readable site summary" href="/llms.txt" />
    <link rel="stylesheet" href="https://sabya.pm/embed/author-card/author-card.css" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="teleprompter.wtf" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={socialImageType} />
    {
      rss && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="teleprompter.wtf guides"
          href={rss}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script>
      import { analytics, bindOpenTeleprompterCtas } from '../domain/analytics';
      import { loadLocalState } from '../domain/localState';
      // Apply a previously stored consent choice on every page, so Umami page views,
      // GA page views, and content-to-product events work site-wide. Undecided or denied
      // means nothing loads.
      const consent = loadLocalState().privacyConsent;
      if (consent.decided && consent.usageAnalytics) analytics.allow();
      bindOpenTeleprompterCtas();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label="teleprompter.wtf home">
          teleprompter<span>.wtf</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/features">Features</a>
          <a href="/guides">Guides</a>
          <a href="/tools">Tools</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <a class="wordmark wordmark--footer" href="/">teleprompter<span>.wtf</span></a>
          <p>Paste. Present. Done. No account required.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/features">Features</a>
          <a href="/guides">Guides</a>
          <a href="/tools">Tools</a>
          <a href="/privacy">Privacy</a>
          <a href="/about">About</a>
          <a href="https://github.com/SABYA648/Telemprompter-WTF" rel="noopener noreferrer"
            >GitHub</a
          >
        </nav>
      </div>
      <!-- Author card: sabya.pm. Replace SOURCE_SLUG only. -->
      <aside class="sabyacard" data-sabyacard="footer" aria-label="Site author">
        <a
          class="sabyacard__portrait"
          href="https://sabya.pm/?utm_source=teleprompter&utm_medium=author_card&utm_campaign=eeat&utm_content=footer"
          target="_blank"
          rel="noopener"
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src="https://sabya.pm/embed/author-card/avatar-96.webp"
            srcset="https://sabya.pm/embed/author-card/avatar-96.webp 1x, https://sabya.pm/embed/author-card/avatar-192.webp 2x"
            width="96"
            height="96"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="sabyacard__body">
          <p class="sabyacard__heading">
            <span class="sabyacard__eyebrow">Built by</span><a
              class="sabyacard__name"
              href="https://sabya.pm/?utm_source=teleprompter&utm_medium=author_card&utm_campaign=eeat&utm_content=footer"
              target="_blank"
              rel="author me noopener">Sabyasachi Mishra</a
            >
          </p>
          <p class="sabyacard__links">
            <span class="sabyacard__icons">
              <a
                class="sabyacard__icon"
                href="https://x.com/SabyaShips"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on X"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"
                  ></path></svg
                ></a
              >
              <a
                class="sabyacard__icon"
                href="https://www.linkedin.com/in/sabya007/"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on LinkedIn"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
                  ></path></svg
                ></a
              >
              <a
                class="sabyacard__icon"
                href="https://github.com/SABYA648"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on GitHub"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58l-.01-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z"
                  ></path></svg
                ></a
              >
            </span>
          </p>
        </div>
        <img
          class="sabyacard__beacon"
          src="https://sabya.pm/api/author-card/view?s=teleprompter&p=footer"
          alt=""
          width="1"
          height="1"
          aria-hidden="true"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </aside>
    </footer>
  </body>
</html>
