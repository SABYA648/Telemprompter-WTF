---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | teleprompter.wtf"
  description="The requested page could not be found."
  noindex
>
  <section class="not-found section-wrap">
    <p class="eyebrow">404 · Missed cue</p>
    <h1>That page is off script.</h1>
    <p>The link may be outdated, but the teleprompter is ready.</p>
    <div>
      <a
        class="button button--primary"
        href="/"
        data-analytics-cta="header"
        data-page-type="not_found">Open teleprompter</a
      ><a class="button button--quiet" href="/guides">Browse guides</a>
    </div>
  </section>
</Layout>
