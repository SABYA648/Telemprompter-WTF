---
import { guideBySlug, guides } from '../../content/guides';
import TeleprompterEmbed from '../../components/TeleprompterEmbed.astro';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const title = `${guide.title} | teleprompter.wtf`;
const canonical = `https://www.teleprompter.wtf/guides/${guide.slug}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    datePublished: guide.updated,
    dateModified: guide.updated,
    author: { '@id': 'https://sabya.pm/#person' },
    publisher: { '@type': 'Organization', name: 'teleprompter.wtf' },
    mainEntityOfPage: canonical,
    ...(guide.illustration
      ? { image: `https://www.teleprompter.wtf${guide.illustration.src}` }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.teleprompter.wtf/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: 'https://www.teleprompter.wtf/guides',
      },
      { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
    ],
  },
];
const related = guide.related.map((slug: string) => guideBySlug.get(slug)).filter(Boolean);
---

<Layout
  title={title}
  description={guide.description}
  ogType="article"
  schema={schema}
  rss="/guides/feed.xml"
>
  <article class="guide-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/guides">Guides</a><span>/</span><span
        aria-current="page">{guide.eyebrow}</span
      >
    </nav>
    <header class="guide-header">
      <p class="eyebrow">{guide.eyebrow}</p>
      <h1>{guide.title}</h1>
      <p>{guide.intro}</p>
      <p class="updated">
        Updated {
          new Date(`${guide.updated}T00:00:00Z`).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          })
        }
      </p>
    </header>
    {
      guide.illustration && (
        <figure class="guide-hero-art">
          <img
            src={guide.illustration.src}
            width="1024"
            height="683"
            alt={guide.illustration.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
    <div class="guide-layout">
      <aside class="guide-toc">
        <p>In this guide</p>
        <ol>
          {
            guide.sections.map((section: { heading: string }, index: number) => (
              <li>
                <a href={`#section-${index + 1}`}>{section.heading}</a>
              </li>
            ))
          }
          {
            guide.embed && (
              <li>
                <a href="#practice">Try it in the teleprompter</a>
              </li>
            )
          }
        </ol>
      </aside>
      <div class="guide-article">
        {
          guide.sections.map(
            (
              section: { heading: string; paragraphs: string[]; bullets?: string[] },
              index: number,
            ) => (
              <section id={`section-${index + 1}`}>
                <p class="section-number">{String(index + 1).padStart(2, '0')}</p>
                <h2>{section.heading}</h2>
                {section.paragraphs.map((paragraph: string) => (
                  <p>{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet: string) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </section>
            ),
          )
        }
        {
          guide.slug === 'voice-activated-teleprompters' && (
            <p class="guide-context-link">
              See the exact local processing boundary in{' '}
              <a href="/private-voice-tracking">How private voice tracking works</a>.
            </p>
          )
        }
        {
          guide.embed && (
            <div id="practice">
              <TeleprompterEmbed
                embedId={`guide-${guide.slug}`}
                intro={guide.embed.intro}
                initialScript={guide.embed.sampleScript}
                {...(guide.embed.preset ? { preset: guide.embed.preset } : {})}
              />
            </div>
          )
        }
      </div>
    </div>
    <!-- Author card: sabya.pm. Replace SOURCE_SLUG only. -->
    <aside class="sabyacard" data-sabyacard="blog" aria-label="About the author">
      <a
        class="sabyacard__portrait"
        href="https://sabya.pm/?utm_source=teleprompter&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
        target="_blank"
        rel="noopener"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src="https://sabya.pm/embed/author-card/avatar-96.webp"
          srcset="https://sabya.pm/embed/author-card/avatar-96.webp 1x, https://sabya.pm/embed/author-card/avatar-192.webp 2x"
          width="96"
          height="96"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="sabyacard__body">
        <p class="sabyacard__heading">
          <span class="sabyacard__eyebrow">Written by</span><a
            class="sabyacard__name"
            href="https://sabya.pm/?utm_source=teleprompter&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
            target="_blank"
            rel="author me noopener">Sabyasachi Mishra</a
          >
        </p>
        <p class="sabyacard__role">AI Product Manager &amp; Systems Builder</p>
        <p class="sabyacard__bio">
          Builds AI products that hold up in production, and independently runs Shiproom,
          teleprompter.wtf, and compressimage.fun.
        </p>
        <p class="sabyacard__links">
          <a
            class="sabyacard__link"
            href="https://sabya.pm/?utm_source=teleprompter&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
            target="_blank"
            rel="author me noopener">sabya.pm</a
          >
          <span class="sabyacard__icons">
            <a
              class="sabyacard__icon"
              href="https://x.com/SabyaShips"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on X"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"
                ></path></svg
              ></a
            >
            <a
              class="sabyacard__icon"
              href="https://www.linkedin.com/in/sabya007/"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on LinkedIn"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
                ></path></svg
              ></a
            >
            <a
              class="sabyacard__icon"
              href="https://github.com/SABYA648"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on GitHub"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58l-.01-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z"
                ></path></svg
              ></a
            >
          </span>
        </p>
      </div>
      <img
        class="sabyacard__beacon"
        src="https://sabya.pm/api/author-card/view?s=teleprompter&p=blog"
        alt=""
        width="1"
        height="1"
        aria-hidden="true"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </aside>
    <section class="related-guides">
      <p class="eyebrow">Keep reading</p><h2>Related guides</h2>
      <div>
        {
          related.map(
            (item) =>
              item && (
                <a href={`/guides/${item.slug}`}>
                  <>
                    <span>{item.eyebrow}</span>
                    <strong>{item.title}</strong>
                    <b aria-hidden="true">→</b>
                  </>
                </a>
              ),
          )
        }
      </div>
    </section>
  </article>
</Layout>
