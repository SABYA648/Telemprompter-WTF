---
import { guides } from '../../content/guides';
import Layout from '../../layouts/Layout.astro';
const title = 'Teleprompter Guides | teleprompter.wtf';
const description =
  'Practical teleprompter guides for setup, natural delivery, eye contact, script formatting, videos, presentations, voice tracking, and scroll speed.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.teleprompter.wtf/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: 'https://www.teleprompter.wtf/guides',
      },
    ],
  },
];
const groups = [
  {
    title: 'Get started',
    slugs: [
      'what-is-a-teleprompter',
      'how-to-use-a-teleprompter',
      'how-to-format-a-teleprompter-script',
      'teleprompter-keyboard-shortcuts',
    ],
  },
  {
    title: 'Recording and camera setup',
    slugs: [
      'teleprompter-for-youtube',
      'teleprompter-for-video-recording',
      'teleprompter-camera-distance-and-font-size',
      'teleprompter-for-zoom',
      'teleprompter-for-online-courses',
      'teleprompter-for-podcasts',
      'teleprompter-for-short-form-video',
    ],
  },
  {
    title: 'Presenting naturally',
    slugs: [
      'teleprompter-for-presentations',
      'how-to-read-a-teleprompter-naturally',
      'how-to-maintain-eye-contact',
      'teleprompter-for-webinars',
      'teleprompter-for-interviews',
    ],
  },
  {
    title: 'Phones and hardware',
    slugs: ['teleprompter-for-phone-and-tablet', 'teleprompter-mirror-mode-glass'],
  },
  {
    title: 'Voice tracking and pacing',
    slugs: [
      'voice-activated-teleprompters',
      'manual-vs-voice-activated-teleprompter',
      'teleprompter-speed',
    ],
  },
].map((group) => ({
  ...group,
  guides: group.slugs.map((slug) => guides.find((guide) => guide.slug === slug)).filter(Boolean),
}));
---

<Layout title={title} description={description} schema={schema} rss="/guides/feed.xml">
  <section class="listing-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Guides</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Practical field notes</p>
      <h1>Use a teleprompter well.</h1>
      <p>
        Clear guidance for writing, pacing, camera placement, and delivering words like you mean
        them.
      </p>
    </header>
    <div class="guide-groups">
      {
        groups.map((group) => (
          <section>
            <div class="section-heading">
              <>
                <p class="eyebrow">Browse by goal</p>
                <h2>{group.title}</h2>
              </>
            </div>
            <div class="guide-grid">
              {group.guides.map(
                (guide, index) =>
                  guide && (
                    <article>
                      <p class="guide-index">
                        {String(index + 1).padStart(2, '0')} · {guide.eyebrow}
                      </p>
                      <h3>
                        <a href={`/guides/${guide.slug}`}>{guide.title}</a>
                      </h3>
                      <p>{guide.description}</p>
                      <a class="arrow-link" href={`/guides/${guide.slug}`}>
                        Read guide <span aria-hidden="true">→</span>
                      </a>
                    </article>
                  ),
              )}
            </div>
          </section>
        ))
      }
    </div>
    <p class="guide-voice-link">
      Looking for the privacy details behind voice follow? <a href="/private-voice-tracking"
        >Read how local voice tracking works</a
      >, or inspect our <a href="/compatibility">Browser & Device Compatibility Matrix</a>.
    </p>
    <aside class="callout">
      <div><p class="eyebrow">Skip the reading</p><h2>Put your script on screen.</h2></div><a
        class="button button--primary"
        href="/"
        data-analytics-cta="callout"
        data-page-type="listing"
        data-content-cluster="getting_started">Open teleprompter</a
      >
    </aside>
  </section>
</Layout>
