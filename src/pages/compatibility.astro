---
import Layout from '../layouts/Layout.astro';
const title = 'Studio Browser Compatibility | teleprompter.wtf';
const description =
  'See which browsers support Studio camera recording, MP4 or WebM export, offline use and the classic teleprompter. Check controls on your own device.';
---

<Layout title={title} description={description}>
  <article class="prose-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Compatibility</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Browser support</p><h1>Studio works where your camera works.</h1><p>
        Camera and microphone access require HTTPS and your permission. Available quality, format
        and controls vary by browser and device.
      </p>
    </header>
    <div class="prose-body prose-body--wide">
      <div
        class="privacy-table-wrap"
        role="region"
        aria-label="Studio browser compatibility"
        tabindex="0"
      >
        <table class="privacy-table">
          <thead
            ><tr
              ><th scope="col">Browser</th><th scope="col">Studio recording</th><th scope="col"
                >Typical file format</th
              ><th scope="col">Notes</th></tr
            ></thead
          ><tbody>
            <tr
              ><th scope="row">iOS Safari 16.4+</th><td>Camera and microphone</td><td
                >MP4, when supported</td
              ><td>Add to Home Screen for a full-screen app. Screen capture is unavailable.</td></tr
            >
            <tr
              ><th scope="row">Android Chrome</th><td>Camera and microphone</td><td
                >MP4 or WebM, selected by capability</td
              ><td>Installable; camera and quality options depend on hardware.</td></tr
            >
            <tr
              ><th scope="row">Desktop Chrome and Edge</th><td>Camera and microphone</td><td
                >MP4 or WebM, selected by capability</td
              ><td>Keyboard and external camera controls are available.</td></tr
            >
            <tr
              ><th scope="row">Desktop Safari</th><td>Camera and microphone</td><td
                >MP4, when supported</td
              ><td>Use the browser's permission controls if the camera is blocked.</td></tr
            >
            <tr
              ><th scope="row">Desktop Firefox</th><td>Camera and microphone</td><td>WebM</td><td
                >Download the WebM file and check the target app accepts it.</td
              ></tr
            >
          </tbody>
        </table>
      </div>
      <h2>Classic presenter</h2><p>
        Manual scrolling, mirrored text and keyboard control work without camera permission. Compact
        view and screen recording depend on browser APIs.
      </p>
      <h2>Before an important take</h2><p>
        Make a short test recording, save it to your device and play it in the app where you plan to
        post. In-app browsers may block recording; open Studio in Safari or Chrome.
      </p>
      <p>
        <a href="/studio?go=record">Open Studio</a> or <a href="/#classic-editor"
          >use the classic teleprompter</a
        >.
      </p>
    </div>
  </article>
</Layout>
