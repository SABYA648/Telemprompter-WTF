---
import Layout from '../layouts/Layout.astro';
const title = 'Privacy and Local Data | teleprompter.wtf';
const description =
  'Learn how teleprompter.wtf stores scripts and settings on your device and uses Umami to measure page views and product events.';
---

<Layout title={title} description={description}>
  <article class="prose-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Privacy</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Privacy</p><h1>Your work stays on your device.</h1>
    </header>
    <div class="prose-body">
      <h2>Scripts and recordings</h2>
      <p>
        Scripts and settings are stored in your browser on this device. Recordings are created
        locally and saved when you choose to download them. The app does not upload your script or
        recording.
      </p>
      <h2>Usage measurement</h2>
      <p>
        We use self-hosted Umami to measure page views and product events with an anonymous device
        identifier stored in your browser. Events do not contain script text, titles or file names.
      </p>
      <p>
        You can clear the saved script and preferences from the editor or remove this site's data in
        your browser settings.
      </p>
      <h2>Questions</h2>
      <p>
        Contact us through the <a
          href="https://github.com/SABYA648/Telemprompter-WTF/issues"
          rel="noopener noreferrer">project issue tracker</a
        >. Please do not include private script content.
      </p>
    </div>
  </article>
</Layout>
