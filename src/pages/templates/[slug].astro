---
import Layout from '../../layouts/Layout.astro';
import { templates } from '../../content/studio';
export function getStaticPaths() {
  return templates.map((template) => ({ params: { slug: template.id }, props: { template } }));
}
const { template } = Astro.props;
const base = 'https://www.teleprompter.wtf';
const url = `${base}/templates/${template.id}`;
const position = templates.findIndex((item) => item.id === template.id);
const previous = templates[(position + templates.length - 1) % templates.length]!;
const next = templates[(position + 1) % templates.length]!;
const lengthLabel =
  template.targetSeconds >= 120
    ? `${Math.round(template.targetSeconds / 60)} minute`
    : `${template.targetSeconds} second`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: template.h1,
    description: template.seoDescription,
    datePublished: '2026-11-05',
    dateModified: '2026-11-05',
    author: { '@id': 'https://sabya.pm/#person' },
    publisher: { '@type': 'Organization', name: 'teleprompter.wtf' },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Templates', item: `${base}/templates` },
      { '@type': 'ListItem', position: 3, name: template.name, item: url },
    ],
  },
];
---

<Layout
  title={template.seoTitle}
  description={template.seoDescription}
  schema={schema}
  ogType="article"
>
  <article class="guide-page section-wrap creator-content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/templates">Templates</a><span>/</span><span
        aria-current="page">{template.name}</span
      >
    </nav>
    <header class="guide-header">
      <p class="eyebrow">{lengthLabel} script · {template.format}</p><h1>
        {template.h1}
      </h1><p>{template.summary}</p>
    </header>
    <h2>When to use it</h2>{template.whenToUse.map((p) => <p>{p}</p>)}
    <h2>Timed beats</h2><ol>
      {
        template.beats.map((beat) => (
          <li>
            <strong>
              {beat.label} ({beat.startSeconds} to {beat.endSeconds} seconds):
            </strong>{' '}
            {beat.instruction}
          </li>
        ))
      }
    </ol>
    <h2>The template</h2><pre class="creator-script">{template.body}</pre><a
      class="button button--primary"
      href={`/studio#/scripts/new?template=${template.id}`}
      data-analytics-cta="inline"
      data-page-type="template">Use this template</a
    >
    <h2>Two filled examples</h2>{
      template.examples.map((example) => (
        <section>
          <>
            <h3>{example.title}</h3>
            <pre class="creator-script">{example.body}</pre>
          </>
        </section>
      ))
    }
    <h2>Tips</h2><ul>{template.tips.map((tip) => <li>{tip}</li>)}</ul>
    <h2>Questions</h2>{
      template.faq.map((item) => (
        <section>
          <>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </>
        </section>
      ))
    }
    <h2>Related</h2><ul>
      <li>
        <a href={`/record/${template.related.recordPreset}`}
          >Record a {template.format} video with a teleprompter</a
        >
      </li>
      {
        template.related.templates.map((id) => {
          const related = templates.find((item) => item.id === id);
          return (
            related && (
              <li>
                <a href={`/templates/${id}`}>{related.name}</a>
              </li>
            )
          );
        })
      }<li><a href={`/hooks/${template.related.hooksNiche}`}>Related hooks</a></li>
    </ul>
    <h2>More templates</h2><ul>
      <li>Previous: <a href={`/templates/${previous.id}`}>{previous.name}</a></li>
      <li>Next: <a href={`/templates/${next.id}`}>{next.name}</a></li>
    </ul>
  </article>
</Layout>
