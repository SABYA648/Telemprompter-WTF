---
import PrivacyChoices from '../components/PrivacyChoices';
import TeleprompterApp from '../components/TeleprompterApp';
import Layout from '../layouts/Layout.astro';

const title = 'Free Online Teleprompter That Follows Your Voice | teleprompter.wtf';
const description =
  'Free online teleprompter that follows your voice. Paste your script and start. Smart Pace listens locally. No login, no ads, and your script stays on your device.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any modern web browser',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    browserRequirements: 'JavaScript is required for presenter controls',
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <section class="home-hero">
    <div class="home-hero__copy">
      <h1>Free online teleprompter that follows your voice</h1>
      <div class="home-hero__support">
        <p>
          Paste your script and start. Smart Pace listens locally and adjusts the scroll as you
          speak.
        </p>
        <p class="home-hero__trust">No login · No ads · Your script stays on your device</p>
      </div>
    </div>
    <TeleprompterApp client:load />
    <PrivacyChoices client:idle />
  </section>

  <section class="home-content section-wrap">
    <div class="section-heading">
      <p class="eyebrow">How it helps</p>
      <h2>It follows your pace.</h2>
      <p>
        Manual scrolling is ready immediately. Smart Pace and Private Precision appear only when you
        ask for them.
      </p>
    </div>
    <div class="feature-list">
      <article>
        <span>01</span><h3>It follows your pace</h3><p>
          Smart Pace uses your microphone locally to match scroll to your speaking rhythm. Pause,
          and it slows. No transcription and no model download.
        </p>
      </article>
      <article>
        <span>02</span><h3>Want tighter following?</h3><p>
          Private Precision Beta can download an optional local voice model (about 67 MB first use)
          to follow your place in the known script. More precise. Still on-device. Still Beta.
        </p>
      </article>
      <article>
        <span>03</span><h3>Keep it beside your camera</h3><p>
          Picture in Picture uses the best browser path available, with a pop-out fallback when
          native compact windows are unavailable.
        </p>
      </article>
    </div>
    <div class="feature-list feature-list--secondary">
      <article>
        <span>04</span><h3>Record locally</h3><p>
          Capture a screen or camera where browser support permits. Preview and save the real file
          without an upload step.
        </p>
      </article>
      <article>
        <span>05</span><h3>Your script stays yours</h3><p>
          Scripts, microphone processing, and recordings stay on your device. Optional analytics
          never receive your script or voice content.
        </p>
      </article>
      <article>
        <span>06</span><h3>Free. No account.</h3><p>
          Open it and get to work. No login, no ads, and no cloud script storage. The source is on
          GitHub.
        </p>
      </article>
    </div>
    <p class="home-voice-link">
      Want the technical privacy boundary? <a href="/private-voice-tracking"
        >See how local voice tracking works</a
      >. Compare the full <a href="/features">feature set</a> or read the
      <a href="/privacy">privacy policy</a>.
    </p>
    <div class="home-links">
      <div>
        <p class="eyebrow">New to prompting?</p><h2>Deliver naturally, not mechanically.</h2>
      </div>
      <div class="link-stack">
        <a href="/guides/how-to-use-a-teleprompter"
          ><span>Read the practical setup guide</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides/teleprompter-speed"
          ><span>Choose the right scroll speed</span><b aria-hidden="true">↗</b></a
        >
        <a href="/tools/words-to-minutes"
          ><span>Turn word count into speaking time</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides"><span>Browse all teleprompter guides</span><b aria-hidden="true">↗</b></a>
        <a href="/tools"><span>Open the free planning tools</span><b aria-hidden="true">↗</b></a>
      </div>
    </div>
  </section>
</Layout>
