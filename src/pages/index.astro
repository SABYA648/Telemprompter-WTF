---
import TeleprompterApp from '../components/TeleprompterApp';
import Layout from '../layouts/Layout.astro';

const title = 'Free Online Teleprompter | teleprompter.wtf';
const description =
  'A free online teleprompter with adjustable scrolling, local script storage, mirroring and recording. Paste your script and present without an account.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    image: 'https://www.teleprompter.wtf/illustrations/teleprompter-og.webp',
    featureList: [
      'Manual elapsed-time scrolling',
      'Local screen and camera recording',
      'Horizontal mirroring for beam-splitter glass',
      'Document Picture in Picture and compact view',
      'Local autosave and plain-text TXT import',
    ],
    browserRequirements:
      'Requires JavaScript and modern browser APIs (Web Audio, Canvas, MediaRecorder)',
  },
];
---

<Layout
  title={title}
  description={description}
  image="/illustrations/teleprompter-og.webp"
  schema={schema}
>
  <section class="home-hero">
    <div class="home-hero__split">
      <div class="home-hero__copy">
        <p class="eyebrow">Free · No signup · Private by design</p>
        <h1>Free online teleprompter</h1>
        <p class="home-hero__lead">
          Paste your script and start. Adjust the scrolling speed as you speak, then pause or
          restart whenever you need.
        </p>
        <ul class="home-hero__promises">
          <li>No login</li>
          <li>No ads</li>
          <li>No watermark</li>
          <li>Scripts stay on your device</li>
        </ul>
      </div>
      <figure class="home-hero__art">
        <img
          src="/illustrations/teleprompter-hero.webp"
          width="1024"
          height="683"
          alt="Blank script cards flowing through teleprompter glass toward a camera lens"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
    <TeleprompterApp client:load />
  </section>

  <section class="home-content section-wrap">
    <div class="section-heading">
      <p class="eyebrow">Made for presenting</p>
      <h2>Control that matches your take.</h2>
      <p>Adjust the speed and presentation to suit your script.</p>
    </div>
    <div class="feature-list feature-list--secondary">
      <article>
        <span>04</span><h3>Keep it beside your camera</h3><p>
          Document Picture in Picture on Chromium browsers, with video Picture in Picture and
          pop-out window fallbacks on Firefox and Safari.
        </p>
      </article>
      <article>
        <span>05</span><h3>Prompter-rig ready</h3><p>
          Mirror horizontally for beam-splitter glass, flip vertically for inverted displays, and
          present in fullscreen without browser distractions.
        </p>
      </article>
      <article>
        <span>06</span><h3>Record locally</h3><p>
          Capture your camera or screen directly in the browser. Preview and save your video locally
          without any server upload or watermark.
        </p>
      </article>
    </div>

    <div class="home-links">
      <div>
        <p class="eyebrow">Creator & speaker guides</p><h2>Deliver naturally, not mechanically.</h2>
      </div>
      <div class="link-stack">
        <a href="/guides/how-to-use-a-teleprompter"
          ><span>How to use a teleprompter without sounding scripted</span><b aria-hidden="true"
            >↗</b
          ></a
        >
        <a href="/guides/manual-vs-voice-activated-teleprompter"
          ><span>Manual vs. voice-activated teleprompter: which to choose</span><b
            aria-hidden="true">↗</b
          ></a
        >
        <a href="/guides/teleprompter-camera-distance-and-font-size"
          ><span>Camera distance, font size, and line width guide</span><b aria-hidden="true">↗</b
          ></a
        >
        <a href="/guides/teleprompter-speed"
          ><span>Choosing the right teleprompter speed and WPM</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides/teleprompter-for-youtube"
          ><span>Teleprompter setup for YouTube videos</span><b aria-hidden="true">↗</b></a
        >
        <a href="/tools/words-to-minutes"
          ><span>Turn word count into speaking time</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides"><span>Browse all teleprompter guides</span><b aria-hidden="true">↗</b></a>
        <a href="/tools"
          ><span>Open all free planning calculators</span><b aria-hidden="true">↗</b></a
        >
      </div>
    </div>
  </section>
</Layout>
