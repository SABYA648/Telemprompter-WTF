---
import TeleprompterApp from '../components/TeleprompterApp';
import Layout from '../layouts/Layout.astro';
const title = 'Free Online Teleprompter with Camera | teleprompter.wtf';
const description =
  'Read your script right under the lens and record Reels, Shorts and YouTube videos in your browser. Free, no signup, no watermark. Videos save to your device.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    image: 'https://www.teleprompter.wtf/illustrations/teleprompter-og.webp',
    featureList: [
      'Camera recording with a lens-side teleprompter',
      'Local script library and takes',
      'Manual WPM scrolling',
      'Horizontal mirroring',
      'Offline Studio',
      'Local video export',
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  image="/illustrations/teleprompter-og.webp"
  schema={schema}
>
  <section class="home-hero">
    <div class="home-hero__split">
      <div class="home-hero__copy">
        <p class="eyebrow">Free · No signup · No watermark</p>
        <h1>Free online teleprompter with camera for Reels, Shorts and YouTube</h1>
        <p class="home-hero__lead">
          Write or paste a script, then record with the words right under your lens. Redo any line,
          keep your best take, and save it straight to your phone. Nothing is uploaded.
        </p>
        <div class="home-hero__actions">
          <a
            class="button button--primary"
            href="/studio?go=record"
            data-analytics-cta="hero"
            data-page-type="home"
            data-content-cluster="home">Record a video</a
          >
          <a class="button" href="#classic-editor">Use the classic teleprompter</a>
        </div>
        <ul class="home-hero__promises">
          <li>No login</li><li>No watermark</li><li>1080p and 4K</li><li>Saves to your device</li>
        </ul>
      </div>
      <figure class="home-hero__art">
        <img
          src="/illustrations/teleprompter-hero.webp"
          width="1024"
          height="683"
          alt="Script cards beside a camera lens"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
    <div id="classic-editor"><TeleprompterApp client:load /></div>
  </section>
  <div class="home-content section-wrap">
    <section class="launch-block">
      <p class="eyebrow">Three simple steps</p><h2>How it works</h2>
      <ol>
        <li>1. Write or paste your script.</li><li>2. Record with the words under your lens.</li><li
        >
          3. Save to your phone and post anywhere.
        </li>
      </ol>
    </section>
    <section class="launch-block">
      <h2>What other apps charge for, free here</h2><p>
        Record with a lens-side prompter, retake sections, use camera and microphone controls, keep
        takes in a local library, and export without a watermark.
      </p><a href="/features">Explore Studio and classic features</a>
    </section>
    <section class="launch-block">
      <h2>Made for Reels, Shorts and YouTube</h2><p>
        Use a vertical frame for short videos or switch to landscape for YouTube. Studio keeps your
        scripts, settings and takes on this device. Start from a
        <a href="/templates">video script template</a> or a
        <a href="/hooks">hook written for your niche</a>.
      </p><a href="/record">Choose a recording preset</a>
    </section>
    <section class="launch-block">
      <h2>Common questions</h2>
      <h3>Is it really free?</h3><p>Yes. No trial, no paywall, no watermark.</p>
      <h3>Where is my video saved?</h3><p>
        On your device until you save it to Photos or download it. Nothing is uploaded.
      </p>
      <h3>Does it work on iPhone and Android?</h3><p>
        Yes, in Safari and Chrome. Add it to your Home Screen for full-screen recording.
      </p>
      <h3>Can I post straight to Instagram?</h3><p>
        Save the video, then post it from Instagram, or pick Instagram in the share sheet.
      </p>
      <h3>Does it work for landscape YouTube videos?</h3><p>
        Yes. Switch to 16:9 on your laptop or turn your phone sideways.
      </p>
    </section>
    <div class="home-links">
      <div><p class="eyebrow">Learn more</p><h2>Plan and record your next video.</h2></div><div
        class="link-stack"
      >
        <a href="/guides/teleprompter-for-short-form-video">Short-form video guide</a><a
          href="/guides/teleprompter-for-youtube">YouTube teleprompter guide</a
        ><a href="/guides/capcut-teleprompter">CapCut teleprompter workflow</a><a
          href="/guides/teleprompter-remote-control">Control recording with a clicker</a
        ><a href="/record/instagram-reels">Record an Instagram Reel</a><a
          href="/record/youtube-shorts">Record a YouTube Short</a
        ><a href="/record/tiktok">Record a TikTok video</a><a href="/record/youtube"
          >Record a landscape YouTube video</a
        ><a href="/record/linkedin-video">Record a LinkedIn video</a><a
          href="/tools/script-length-checker">Check a short script length</a
        ><a href="/tools/caption-counter">Count caption characters</a><a
          href="/tools/hook-generator">Generate a template-based hook</a
        ><a href="/tools/words-to-minutes">Script timing tool</a><a href="/templates"
          >Video script templates</a
        ><a href="/hooks">Hooks by niche</a><a href="/guides">Browse all guides</a>
      </div>
    </div>
  </div>
</Layout>
