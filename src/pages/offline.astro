---
import StudioLayout from '../layouts/StudioLayout.astro';
---

<StudioLayout
  title="Offline | teleprompter.wtf"
  description="Open Studio offline, or reconnect to view this page."
  canonical="https://www.teleprompter.wtf/offline"
>
  <div class="studio-shell">
    <section class="studio-screen">
      <h1>You're offline</h1>
      <p>Studio is available offline. This page needs a connection before you can open it.</p>
      <a class="studio-button" href="/studio">Open Studio</a>
    </section>
  </div>
</StudioLayout>
