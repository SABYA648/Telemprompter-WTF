---
import Layout from '../layouts/Layout.astro';
const title = 'Studio and Classic Teleprompter Features | teleprompter.wtf';
const description =
  'Record video with a lens-side teleprompter in Studio, or use the classic presenter for scrolling, mirroring and compact views. Free and local to your device.';
---

<Layout title={title} description={description}>
  <article class="content-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Features</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Two ways to read on camera</p><h1>
        Record in Studio or present with the classic teleprompter.
      </h1><p>Both work in your browser, without an account or watermark.</p><a
        class="button button--primary"
        data-analytics-cta="header"
        data-page-type="feature"
        data-content-cluster="features"
        href="/studio?go=record">Record a video</a
      >
    </header>
    <div class="feature-detail-grid">
      <section>
        <h2>Studio: record beside the lens</h2><p>
          Keep your script close to the camera while recording a vertical or landscape video. Set
          WPM, pause at markers, and keep the best take.
        </p>
      </section>
      <section>
        <h2>Studio: camera and mic controls</h2><p>
          Choose a camera, microphone, resolution and frame rate where your device supports them.
          Check room noise, light and storage before recording.
        </p>
      </section>
      <section>
        <h2>Studio: local library and export</h2><p>
          Scripts, settings and takes live on this device. Share a take to Photos or Files, or
          download it. Add Studio to your Home Screen to use it offline.
        </p>
      </section>
      <section>
        <h2>Classic: simple scrolling</h2><p>
          Paste a script on the <a href="/#classic-editor">homepage editor</a>, set your pace and
          present. Pause, resume and use the keyboard without camera permission.
        </p>
      </section>
      <section>
        <h2>Classic: prompter rigs</h2><p>
          Mirror text for beam-splitter glass, adjust the reading view and open a compact presenter
          window. Screen or camera recording is available where the browser supports it.
        </p>
      </section>
      <section>
        <h2>Local by design</h2><p>
          Neither mode uploads script text or recordings. Umami measures page views and product
          actions without script text or file names. Read our <a href="/privacy">privacy policy</a>.
        </p>
      </section>
    </div>
    <p>
      Check <a href="/compatibility">browser compatibility</a>, plan your read with the <a
        href="/tools/words-to-minutes">words-to-minutes tool</a
      >, or read the <a href="/guides/teleprompter-for-short-form-video">short-form video guide</a>.
    </p>
  </article>
</Layout>
