---
import Layout from '../layouts/Layout.astro';
const title = 'Teleprompter Features: Scrolling and Recording | teleprompter.wtf';
const description =
  'Explore manual scrolling, local recording, beam-splitter mirroring, keyboard shortcuts, compact views and accessible display controls.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.teleprompter.wtf/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Features',
        item: 'https://www.teleprompter.wtf/features',
      },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <article class="content-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Features</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Built for the take</p>
      <h1>Simple on the surface. Capable when needed.</h1>
      <p>
        Paste and present immediately. Manual scrolling, in-browser recording, and compact-view
        tools stay behind clear controls until you need them.
      </p>
      <a
        class="button button--primary"
        href="/"
        data-analytics-cta="header"
        data-page-type="feature"
        data-content-cluster="features">Open the teleprompter</a
      >
    </header>
    <div class="feature-detail-grid">
      <section>
        <p class="feature-number">01</p><h2>Smooth Manual Scrolling</h2><p>
          The scroll engine uses elapsed time rather than frame counts, so speed stays consistent on
          standard and high-refresh displays. Adjust speed from 1 to 10 and pause or resume without
          jumps.
        </p>
      </section>
      <section>
        <p class="feature-number">04</p><h2>A Readable Stage</h2><p>
          Control font size, line height, text width, text alignment, and focus position. A
          near-black presenter theme keeps attention on warm, high-contrast type with an optional
          focus guide line.
        </p>
      </section>
      <section>
        <p class="feature-number">05</p><h2>Prompter-Rig Ready</h2><p>
          Mirror text horizontally for beam-splitter glass, flip vertically for inverted setups, and
          present in fullscreen without operating-system or browser chrome distractions.
        </p>
      </section>
      <section>
        <p class="feature-number">06</p><h2>Local Video Recording</h2><p>
          Record your display, window, tab, or camera directly in the browser using MediaRecorder.
          Microphone audio is optional. Preview and save the real video file locally without uploads
          or watermarks.
        </p>
      </section>
      <section>
        <p class="feature-number">07</p><h2>Compact Presenter Views</h2><p>
          Document Picture in Picture is preferred for Chromium browsers, with canvas-backed video
          Picture in Picture and a dedicated pop-out window for Firefox and Safari.
        </p>
      </section>
      <section>
        <p class="feature-number">08</p><h2>Full Keyboard Control</h2><p>
          Control the take effortlessly: Space for play/pause, Up/Down arrows for scroll speed,
          brackets for font size, F for fullscreen, M for horizontal mirror, and Home to restart.
        </p>
      </section>
      <section>
        <p class="feature-number">09</p><h2>Local, Resilient Editing</h2><p>
          Type or paste plain text with native undo and redo. Paragraph breaks are preserved, TXT
          files import locally, and browser autosave restores your script after a refresh.
        </p>
      </section>
      <section>
        <p class="feature-number">10</p><h2>Inspectable Local Privacy</h2><p>
          There is no script backend, speech server, or recording upload. Optional analytics are off
          by default, and script text or voice audio is never sent over the network.
        </p>
      </section>
    </div>

    <p>Read our <a href="/compatibility">browser compatibility guide</a>.</p>

    <aside class="callout">
      <div><p class="eyebrow">Ready?</p><h2>Paste. Present. Done.</h2></div><a
        class="button button--primary"
        href="/"
        data-analytics-cta="end"
        data-page-type="feature"
        data-content-cluster="features">Start teleprompter</a
      >
    </aside>
  </article>
</Layout>
