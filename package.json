{
  "name": "teleprompter-wtf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, private, free online teleprompter.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "assets:verify": "node scripts/verify-illustration-pack.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:lint": "node scripts/content-lint.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:docker": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:8080 playwright test",
    "test:seo-crawl": "node scripts/seo-crawl-check.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "revenue:estimate": "node scripts/revenue-estimate.mjs",
    "check": "npm run assets:verify && npm run typecheck && npm run lint && npm run content:lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.5.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
